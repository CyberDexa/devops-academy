// DevOps Academy Database Schema
// SQLite database for tracking learning progress

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// User model for multi-user support
model User {
  id          String   @id @default(cuid())
  name        String
  email       String?  @unique
  avatar      String?  // URL or initials
  totalXp     Int      @default(0)
  level       Int      @default(1)
  streak      Int      @default(0)
  longestStreak Int    @default(0)
  lastActiveAt DateTime @default(now())
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  lessonProgress    LessonProgress[]
  dailyActivity     DailyActivity[]
  achievements      UserAchievement[]
  skills            UserSkill[]
  labExerciseProgress LabExerciseProgress[]
  labSessions       LabSession[]
}

// Learning Tracks (Phases: Foundation, Core DevOps, Advanced, etc.)
model Track {
  id          String   @id @default(cuid())
  title       String
  subtitle    String   @default("")
  slug        String   @unique
  description String
  icon        String   @default("terminal")
  color       String   @default("emerald")
  level       String   @default("beginner") // beginner, intermediate, advanced, expert
  duration    String   @default("10-15 hours")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  modules     Module[]
}

// Modules within a track
model Module {
  id          String   @id @default(cuid())
  title       String
  slug        String
  description String
  duration    String   @default("2-4 hours")
  order       Int      @default(0)
  trackId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  track       Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  
  @@unique([trackId, slug])
}

// Individual lessons
model Lesson {
  id            String   @id @default(cuid())
  title         String
  slug          String
  description   String
  content       String   // MDX content
  type          String   @default("tutorial") // tutorial, lab, quiz, project
  difficulty    String   @default("beginner") // beginner, intermediate, advanced
  estimatedTime Int      @default(30) // minutes
  xpReward      Int      @default(100) // XP earned on completion
  order         Int      @default(0)
  moduleId      String
  
  // Lab configuration
  hasTerminal   Boolean  @default(false)
  dockerImage   String?  // Docker image for lab environment
  labConfig     String?  // JSON config for lab setup
  codeExamples  String?  // JSON array of code examples
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      LessonProgress[]
  
  @@unique([moduleId, slug])
}

// User progress tracking
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  status      String   @default("not_started") // not_started, in_progress, completed
  completedAt DateTime?
  timeSpent   Int      @default(0) // seconds
  xpEarned    Int      @default(0)
  notes       String?  // User notes
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@unique([userId, lessonId])
}

// Daily streaks and activity
model DailyActivity {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  lessonsCompleted Int @default(0)
  timeSpent   Int      @default(0) // seconds
  xpEarned    Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date])
}

// Achievement definitions (global)
model Achievement {
  id          String   @id @default(cuid())
  type        String   // streak, completion, milestone, skill
  title       String   @unique
  description String
  icon        String
  xpReward    Int      @default(0)
  requirement String?  // JSON criteria for unlocking
  
  createdAt   DateTime @default(now())
  
  users       UserAchievement[]
}

// User's unlocked achievements
model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  @@unique([userId, achievementId])
}

// Skill definitions (global)
model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String   // devops, mlops, cloud, tools
  icon        String?
  color       String?
  
  createdAt   DateTime @default(now())
  
  users       UserSkill[]
}

// User's skill progress
model UserSkill {
  id          String   @id @default(cuid())
  userId      String
  skillId     String
  level       Int      @default(0) // 0-100
  xp          Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  
  @@unique([userId, skillId])
}

// Lab Exercise Progress
model LabExerciseProgress {
  id            String    @id @default(cuid())
  userId        String
  labId         String    // linux, docker, kubernetes, etc.
  exerciseId    String    // References exercise ID from lab-exercises.ts
  status        String    @default("not_started") // not_started, in_progress, completed
  currentStep   Int       @default(0)
  completedSteps String   @default("[]") // JSON array of completed step IDs
  xpEarned      Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, labId, exerciseId])
}

// Lab Session Tracking
model LabSession {
  id            String    @id @default(cuid())
  userId        String
  labId         String    // linux, docker, kubernetes, etc.
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  duration      Int       @default(0) // seconds
  commandsRun   Int       @default(0)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
